# Required: credentials for the DB API Marketplace (https://developers.deutschebahn.com)
# You need an active subscription to BOTH products:
#   - OpenBoards   (departure/arrival boards)
#   - OpenStation  (station name -> EVA/DHID/StaDa lookup, needed to resolve station names)
DB_OPENBOARDS_CLIENT_ID=your-client-id
DB_OPENBOARDS_CLIENT_SECRET=your-client-secret

# Optional
# DB_OPENBOARDS_BASE_URL=https://apis.deutschebahn.com/db-api-marketplace/apis/open-boards/v1
# DB_OPENSTATION_BASE_URL=https://apis.deutschebahn.com/db-api-marketplace/apis/open-station/v1/netex
# DB_OPENBOARDS_CACHE_PATH=~/.cache/db-openboards-mcp/stations.json
# DB_OPENBOARDS_DEFAULT_STATION=Hamburg Hbf
